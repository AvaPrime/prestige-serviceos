# Supabase public client config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Compatibility alias for older examples/components if needed.
# Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY in new code.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never expose to browser/client bundles.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side cron protection
CRON_SECRET=

# Optional notification providers for later phases
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
